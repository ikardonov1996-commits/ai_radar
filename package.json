    "cron:verify": "tsx scripts/verify-tokens.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cheerio": "^1.2.0",
    "framer-motion": "^12.43.0",
    "google-play-scraper": "^10.1.3",
    "jose": "^6.2.12",
    "next": "^15.5.27",
    "prisma": "^6.19.3",
    "react": "19.1",
    "react-dom": "19.1",
    "resend": "^6.32.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  }
}
