{
  "name": "ai-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "seed:parse": "tsx scripts/seed-parse.ts",
